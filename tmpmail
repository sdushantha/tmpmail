#!/usr/bin/env sh
#
# by Siddharth Dushantha 2020
# fork: https://github.com/3-mmc/tmpmail
#
# The 1secmail API this was built on shut down (every request returns 403),
# so tmpmail now speaks to one of these providers:
#
#   guerrilla  Guerrilla Mail (default): no account, many domains, mails are
#              deleted after an hour
#   mailtm     mail.tm: real account behind each address, account creation
#              is rate limited
#
# Message IDs are short inbox numbers (1 = newest).
#
# Dependencies: jq, curl, w3m
#

version=1.3.0

browser="w3m"
copy_to_clipboard_cmd="xclip -selection c"
raw_text=false
provider=${TMPMAIL_PROVIDER:-guerrilla}

# Kept under /tmp on purpose: the address and its mails vanish on reboot
tmpmail_dir="/tmp/tmpmail"
tmpmail_email_address="$tmpmail_dir/email_address"
tmpmail_provider="$tmpmail_dir/provider"
tmpmail_password="$tmpmail_dir/password"
tmpmail_html_email="$tmpmail_dir/tmpmail.html"
tmpmail_attachments="$tmpmail_dir/attachments"

usage() {
    cat <<EOF
tmpmail
tmpmail -h | --version
tmpmail [-p PROVIDER] -g [ADDRESS | USERNAME]
tmpmail [-t | -b BROWSER] -r | ID

When called with no option and no argument, tmpmail lists the messages in
the inbox and their numbers.  When called with one argument, tmpmail
shows the email message with that number (1 = newest).

-b, --browser BROWSER
        Specify BROWSER that is used to render the HTML of
        the email (default: w3m)
    --clipboard-cmd COMMAND
        Specify the COMMAND to use for copying the email address to your
        clipboard (default: xclip -selection c)
-c, --copy
        Copy the email address to your clipboard
-d, --domains
        Show list of available domains
-g, --generate [ADDRESS | USERNAME]
        Generate a new email address, either the specified ADDRESS, a
        USERNAME on a random domain, or a completely random one
-h, --help
        Show help
-p, --provider PROVIDER
        Service used for new addresses: guerrilla (default) or mailtm.
        Can also be set with TMPMAIL_PROVIDER. An existing address keeps
        the provider it was made with.
-r, --recent
        View the most recent email message
-t, --text
        View the email as raw text, where all the HTML tags are removed.
        Without this option, HTML is used.
--version
        Show version
EOF
}

die() {
    printf "%b\n" "Error: $1" >&2
    exit 1
}

# http METHOD URL [JSON_BODY] -- prints the response body, dies on HTTP errors.
# Sends $auth_header when set.
http() {
    method=$1 url=$2 body=$3
    set -- -sS -X "$method" -H "Accept: application/json" -w '\n%{http_code}'
    [ -n "$auth_header" ] && set -- "$@" -H "$auth_header"
    [ -n "$body" ] && set -- "$@" -H "Content-Type: application/json" --data "$body"
    response=$(curl "$@" "$url") || die "Could not reach $provider"
    status=$(printf %s "$response" | tail -n 1)
    response=$(printf %s "$response" | sed '$d')
    case "$status" in
        2*) printf %s "$response" ;;
        *)
            reason=$(printf %s "$response" | jq -r '.violations[0].message // ."hydra:description" // .message // empty' 2>/dev/null)
            die "$provider returned HTTP $status${reason:+: $reason}"
            ;;
    esac
}

random_string() {
    head -c 200 /dev/urandom | LC_ALL=C tr -dc "$1" | cut -c1-"$2"
}

randomize() {
    awk 'BEGIN {srand();} {print rand(), $0}' | sort -n -k1 | cut -d' ' -f2
}

html_escape() {
    sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g'
}

# ---------------------------------------------------------------------------
# Providers. Each one implements:
#   <p>_domains            one domain per line
#   <p>_create ADDRESS     register ADDRESS (user@domain) and print the
#                          address the service actually assigned
#   <p>_login              prepare $auth_header / session for the calls below
#   <p>_list               JSON array of {id, from, subject}, newest first
#   <p>_read ID            JSON {from, subject, html, text,
#                          attachments: [{url, filename}]}
# ---------------------------------------------------------------------------

guerrilla_api="https://api.guerrillamail.com/ajax.php"

guerrilla_domains() {
    # Every Guerrilla Mail domain delivers into the same inbox for a username
    printf "%s\n" guerrillamail.com guerrillamail.net guerrillamail.org \
        guerrillamail.biz guerrillamail.de guerrillamail.info \
        guerrillamailblock.com sharklasers.com grr.la pokemail.net spam4.me
}

guerrilla_call() {
    http GET "$guerrilla_api?$1${sid:+&sid_token=$sid}"
}

guerrilla_create() {
    sid=""
    data=$(guerrilla_call "f=get_email_address") || exit 1
    sid=$(printf %s "$data" | jq -r .sid_token)
    data=$(guerrilla_call "f=set_email_user&email_user=${1%@*}") || exit 1
    # The service may alter the username (it lowercases and strips symbols)
    printf "%s@%s\n" "$(printf %s "$data" | jq -r '.email_addr | split("@")[0]')" "${1#*@}"
}

guerrilla_login() {
    # Sessions expire after 18 idle minutes; the inbox belongs to the
    # username, so a fresh session that claims it again sees the same mail.
    # Not via $(...), so $sid survives for the calls that follow.
    sid=""
    data=$(guerrilla_call "f=get_email_address") || exit 1
    sid=$(printf %s "$data" | jq -r .sid_token)
    guerrilla_call "f=set_email_user&email_user=${email_address%@*}" >/dev/null || exit 1
}

guerrilla_list() {
    data=$(guerrilla_call "f=get_email_list&offset=0") || exit 1
    printf %s "$data" | jq -c '[.list[] | {id: .mail_id, from: .mail_from,
        subject: (.mail_subject | gsub("&#0?39;"; "'"'"'") | gsub("&quot;"; "\"") | gsub("&lt;"; "<") | gsub("&gt;"; ">") | gsub("&amp;"; "&"))}]
        | sort_by(.id | tonumber) | reverse'
}

guerrilla_read() {
    data=$(guerrilla_call "f=fetch_email&email_id=$1") || exit 1
    printf %s "$data" | jq -c --arg sid "$sid" --arg id "$1" '{
        from: .mail_from, subject: .mail_subject, html: .mail_body, text: "",
        attachments: [(.att_info // [])[] |
            {filename: (.f // "attachment"),
             url: "https://www.guerrillamail.com/inbox?get_att&email_id=\($id)&part_id=\(.p)&sid_token=\($sid)"}]}'
}

mailtm_api="https://api.mail.tm"

# mail.tm answers a bare array for application/json lists; also accept a
# hydra collection in case that ever changes
mailtm_members='def members: if type == "array" then . else ."hydra:member" end;'

mailtm_domains() {
    data=$(http GET "$mailtm_api/domains") || exit 1
    printf %s "$data" | jq -r "$mailtm_members"' members[] | select(.isActive) | .domain'
}

mailtm_create() {
    password=$(random_string 'A-Za-z0-9' 24)
    http POST "$mailtm_api/accounts" "{\"address\":\"$1\",\"password\":\"$password\"}" >/dev/null || exit 1
    (umask 077 && printf %s "$password" >"$tmpmail_password")
    printf "%s\n" "$1"
}

mailtm_login() {
    [ -s "$tmpmail_password" ] || die "Password for $email_address is missing, run 'tmpmail -g'"
    data=$(http POST "$mailtm_api/token" "{\"address\":\"$email_address\",\"password\":\"$(cat "$tmpmail_password")\"}") || exit 1
    auth_header="Authorization: Bearer $(printf %s "$data" | jq -r .token)"
}

mailtm_list() {
    data=$(http GET "$mailtm_api/messages") || exit 1
    printf %s "$data" | jq -c "$mailtm_members"' [members[] | {id, from: .from.address, subject}]'
}

mailtm_read() {
    data=$(http GET "$mailtm_api/messages/$1") || exit 1
    printf %s "$data" | jq -c --arg api "$mailtm_api" '{
        from: (.from | if .name != "" then "\(.name) <\(.address)>" else .address end),
        subject, html: ((.html // []) | join("")), text: (.text // ""),
        attachments: [(.attachments // [])[] | {filename, url: "\($api)\(.downloadUrl)"}]}'
}

# ---------------------------------------------------------------------------

check_provider() {
    case "$provider" in
        guerrilla | mailtm) ;;
        *) die "Unknown provider '$provider'. Use guerrilla or mailtm." ;;
    esac
}

show_list_of_domains() {
    domains=$("${provider}_domains") || exit 1
    printf "List of available %s domains: \n%s\n" "$provider" "$(printf %s "$domains" | sed "s/^/- /")"
}

generate_email_address() {
    externally=${1:-false}
    custom=${2:-false}

    domains=$("${provider}_domains") || exit 1
    [ -z "$domains" ] && die "$provider has no domains available right now"

    if [ "$custom" != false ]; then
        email_address=$(printf %s "$custom" | tr "[:upper:]" "[:lower:]")
        # A bare username gets a random domain
        case "$email_address" in
            *@*) ;;
            *) email_address="$email_address@$(printf %s "$domains" | randomize | tail -1)" ;;
        esac
        valid_email_address_regex="^[a-z0-9._-]+@($(printf %s "$domains" | sed 's/\./\\./g' | tr '\n' '|'))$"
        printf %s "$email_address" | grep -Eq "$valid_email_address_regex" ||
            die "Provided email is invalid. The domain must be one of:\n$(printf %s "$domains" | sed 's/^/- /')"
    else
        domain=$(printf %s "$domains" | randomize | tail -1)
        email_address="$(random_string 'a-z0-9' 11)@$domain"
    fi

    email_address=$("${provider}_create" "$email_address") || exit 1

    printf %s "$email_address" >"$tmpmail_email_address"
    printf %s "$provider" >"$tmpmail_provider"

    if [ "$externally" = true ]; then
        printf "%s\n" "$email_address"
    fi
}

load_email_address() {
    # Addresses from before the provider switch have no provider file and
    # belong to the dead 1secmail or an older mail.tm port, so start over
    if [ ! -s "$tmpmail_email_address" ] || [ ! -s "$tmpmail_provider" ]; then
        (generate_email_address) || exit 1
    fi
    email_address=$(head -n 1 "$tmpmail_email_address")
    provider=$(cat "$tmpmail_provider")
    check_provider
}

fetch_messages() {
    messages=$("${provider}_list") || exit 1
}

list_emails() {
    fetch_messages
    printf "[ Inbox for %s ]\n\n" "$email_address"

    [ "$(printf %s "$messages" | jq length)" -eq 0 ] && echo "No new mail" && exit

    printf %s "$messages" |
        jq -r 'to_entries[] | "\(.key + 1) ||\(.value.from) ||\(.value.subject)"' |
        column -t -s "||"
}

view_email() {
    fetch_messages
    email_id=$(printf %s "$messages" | jq -r --argjson n "$1" '.[$n - 1].id // empty')
    [ -z "$email_id" ] && die "Message not found"

    data=$("${provider}_read" "$email_id") || exit 1

    from=$(printf %s "$data" | jq -r .from | html_escape)
    # Guerrilla Mail already sends the subject HTML-escaped
    subject=$(printf %s "$data" | jq -r .subject)
    [ "$provider" = mailtm ] && subject=$(printf %s "$subject" | html_escape)
    html_body=$(printf %s "$data" | jq -r .html)
    [ -z "$html_body" ] && html_body="<pre>$(printf %s "$data" | jq -r .text | html_escape)</pre>"

    html_mail=$(cat <<EOF
<pre><b>To: </b>$email_address
<b>From: </b>$from
<b>Subject: </b>$subject</pre>
$html_body

EOF
)

    # Attachments may need the session, so fetch them now and link local files
    attachments=$(printf %s "$data" | jq -r '.attachments[] | "\(.url)\t\(.filename)"')
    if [ -n "$attachments" ]; then
        html_mail="$html_mail<br><b>[Attachments]</b><br>"
        mkdir -p "$tmpmail_attachments/$email_id"
        tab=$(printf '\t')
        while IFS="$tab" read -r url filename; do
            filename=$(basename "$filename")
            file="$tmpmail_attachments/$email_id/$filename"
            set -- -sS -o "$file"
            [ -n "$auth_header" ] && set -- "$@" -H "$auth_header"
            curl "$@" "$url"
            if [ "$raw_text" = true ]; then
                html_mail="$html_mail$file<br>"
            else
                html_mail="$html_mail<a href=\"file://$file\">$filename</a><br>"
            fi
        done <<EOF
$attachments
EOF
    fi

    printf %s "$html_mail" >"$tmpmail_html_email"

    [ "$raw_text" = true ] && w3m -dump -T text/html "$tmpmail_html_email" && exit

    $browser "$tmpmail_html_email"
}

copy_email_to_clipboard() {
    # Checked here rather than in main() so the clipboard tool is only
    # required by --copy, and --clipboard-cmd has already been parsed
    command -v "${copy_to_clipboard_cmd%% *}" >/dev/null 2>&1 ||
        die "Could not find the following dependencies: ${copy_to_clipboard_cmd%% *}"
    $copy_to_clipboard_cmd <"$tmpmail_email_address"
}

main() {
    dep_missing=""
    for dependency in jq $browser curl; do
        command -v "$dependency" >/dev/null 2>&1 || dep_missing="$dep_missing $dependency"
    done
    [ "${#dep_missing}" -gt 0 ] && die "Could not find the following dependencies:$dep_missing"

    mkdir -p "$tmpmail_dir"

    # Options that don't need an existing address
    while [ "$1" ]; do
        case "$1" in
            --help | -h) usage && exit ;;
            --version) echo "$version" && exit ;;
            --provider | -p) provider="$2"; shift ;;
            --domains | -d) check_provider && show_list_of_domains && exit ;;
            --generate | -g) check_provider && generate_email_address true "$2" && exit ;;
            *) break ;;
        esac
        shift
    done

    load_email_address
    "${provider}_login"

    [ $# -eq 0 ] && list_emails && exit

    while [ "$1" ]; do
        case "$1" in
            --clipboard-cmd) copy_to_clipboard_cmd="$2"; shift ;;
            --copy | -c) copy_email_to_clipboard && exit ;;
            --browser | -b) browser="$2"; shift ;;
            --text | -t) raw_text=true ;;
            --recent | -r) view_email 1 && exit ;;
            *[!0-9]*) die "'$1' is not an option or a message number" ;;
            *) view_email "$1" && exit ;;
        esac
        shift
    done
}

main "$@"
